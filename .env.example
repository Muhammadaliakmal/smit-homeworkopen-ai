# Copy this file to .env and fill in your own values.
# Never commit the real .env file - it's already in .gitignore.

# Get a free key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Get a key from https://platform.openai.com/api-keys
# Leave blank if you don't have one - only needed when MODEL_PROVIDER=openai
OPENAI_API_KEY=

# Which provider main.py / config_global_level.py should build a client for.
# gemini | openai
MODEL_PROVIDER=gemini

# Current stable Gemini model, from https://ai.google.dev/gemini-api/docs/models
# (balances speed/intelligence for agentic tasks - see README for why this one)
GEMINI_MODEL=gemini-3.5-flash-lite

# Only used when MODEL_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
